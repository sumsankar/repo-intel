{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/repo-intel/repo-intel/blob/main/output/report.schema.json",
  "title": "repo-intel report (SARIF 2.1.0 extended)",
  "description": "A repo-intel report is a valid SARIF 2.1.0 document that additionally requires repo-intel.* property blocks. Consumers that ignore the extension blocks see a standard SARIF document (e.g., GitHub Code Scanning).",
  "type": "object",
  "required": ["$schema", "version", "runs"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json"
    },
    "version": { "const": "2.1.0" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["tool", "invocations", "results", "properties"],
      "properties": {
        "tool": {
          "type": "object",
          "required": ["driver"],
          "properties": {
            "driver": {
              "type": "object",
              "required": ["name", "version", "rules"],
              "properties": {
                "name":           { "const": "repo-intel" },
                "version":        { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
                "informationUri": { "type": "string", "format": "uri" },
                "rules":          { "type": "array", "items": { "$ref": "#/$defs/rule" } }
              }
            }
          }
        },
        "invocations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/invocation" }
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/result" }
        },
        "taxonomies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "enum": ["CWE", "OWASP"] },
              "informationUri": { "type": "string", "format": "uri" },
              "taxa": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } } }
            }
          }
        },
        "properties": { "$ref": "#/$defs/runProperties" }
      }
    },

    "rule": {
      "type": "object",
      "required": ["id", "name", "shortDescription", "defaultConfiguration", "properties"],
      "properties": {
        "id":   { "type": "string", "pattern": "^RI-[A-Z]+-[0-9]{3}-[A-Z0-9-]+$" },
        "name": { "type": "string" },
        "shortDescription": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } },
        "fullDescription":  { "type": "object", "properties": { "text": { "type": "string" } } },
        "helpUri":          { "type": "string", "format": "uri" },
        "defaultConfiguration": {
          "type": "object",
          "required": ["level"],
          "properties": { "level": { "enum": ["none", "note", "warning", "error"] } }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": { "type": "object" },
              "kinds":  { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "properties": {
          "type": "object",
          "required": ["skill", "category", "security-severity"],
          "properties": {
            "skill":    { "type": "string", "enum": ["security", "code", "architecture", "devops", "dependency", "governance"] },
            "category": { "type": "string" },
            "security-severity": { "type": "string", "pattern": "^([0-9]|10)(\\.[0-9])?$" },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "invocation": {
      "type": "object",
      "required": ["executionSuccessful", "startTimeUtc", "endTimeUtc"],
      "properties": {
        "executionSuccessful": { "type": "boolean" },
        "startTimeUtc": { "type": "string", "format": "date-time" },
        "endTimeUtc":   { "type": "string", "format": "date-time" },
        "commandLine":  { "type": "string" },
        "exitCode":     { "type": "integer" },
        "properties": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "subagent_models": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "tokens_input_estimate":  { "type": "integer" },
            "tokens_output_estimate": { "type": "integer" },
            "context_utilization_pct": { "type": "number" },
            "tool_calls": { "type": "integer" }
          }
        }
      }
    },

    "result": {
      "type": "object",
      "required": ["ruleId", "level", "message", "locations", "properties"],
      "properties": {
        "ruleId":  { "type": "string", "pattern": "^RI-[A-Z]+-[0-9]{3}-[A-Z0-9-]+$" },
        "level":   { "enum": ["none", "note", "warning", "error"] },
        "message": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text":     { "type": "string" },
            "markdown": { "type": "string" }
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["physicalLocation"],
            "properties": {
              "physicalLocation": {
                "type": "object",
                "required": ["artifactLocation"],
                "properties": {
                  "artifactLocation": {
                    "type": "object",
                    "required": ["uri"],
                    "properties": {
                      "uri":       { "type": "string" },
                      "uriBaseId": { "type": "string" }
                    }
                  },
                  "region": {
                    "type": "object",
                    "properties": {
                      "startLine":   { "type": "integer", "minimum": 1 },
                      "startColumn": { "type": "integer", "minimum": 1 },
                      "endLine":     { "type": "integer", "minimum": 1 },
                      "endColumn":   { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "fixes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "object", "properties": { "text": { "type": "string" } } },
              "artifactChanges": { "type": "array" }
            }
          }
        },
        "partialFingerprints": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "properties": {
          "type": "object",
          "required": ["skill", "severity"],
          "properties": {
            "skill":        { "type": "string" },
            "severity":     { "enum": ["critical", "high", "medium", "low", "info"] },
            "score_impact": { "type": "number", "maximum": 0 },
            "cwe":          { "type": "string", "pattern": "^CWE-[0-9]+$" },
            "owasp":        { "type": "string" },
            "package":      { "type": "string", "description": "Monorepo package name if applicable" },
            "entropy":      { "type": "number" }
          }
        }
      }
    },

    "runProperties": {
      "type": "object",
      "required": ["repo-intel.schemaVersion", "repo-intel.scores", "repo-intel.repoContext", "repo-intel.findingsSummary"],
      "properties": {
        "repo-intel.schemaVersion": { "const": "1.0" },
        "repo-intel.scores": {
          "type": "object",
          "required": ["overall"],
          "properties": {
            "overall":      { "type": "number", "minimum": 0, "maximum": 10 },
            "security":     { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "code":         { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "architecture": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "devops":       { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "dependency":   { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
            "governance":   { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
          }
        },
        "repo-intel.repoContext": {
          "type": "object",
          "required": ["primaryLanguage", "projectType"],
          "properties": {
            "repositoryUri":   { "type": "string" },
            "commit":          { "type": "string" },
            "branch":          { "type": "string" },
            "primaryLanguage": { "type": "string" },
            "languages":       { "type": "array", "items": { "type": "string" } },
            "projectType":     { "type": "string" },
            "workspace":       { "type": ["string", "null"] },
            "packages":        { "type": "array", "items": { "type": "string" } },
            "totalFiles":      { "type": "integer" },
            "totalLinesOfCode":{ "type": "integer" }
          }
        },
        "repo-intel.findingsSummary": {
          "type": "object",
          "required": ["total"],
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high":     { "type": "integer", "minimum": 0 },
            "medium":   { "type": "integer", "minimum": 0 },
            "low":      { "type": "integer", "minimum": 0 },
            "info":     { "type": "integer", "minimum": 0 },
            "total":    { "type": "integer", "minimum": 0 }
          }
        },
        "repo-intel.skippedSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill", "reason"],
            "properties": {
              "skill":  { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
