# Claude Code — ignore user/local state, keep project-shared wrappers
# (slash commands and subagents are the native surface for this repo —
# see .claude/commands/analyze.md and .claude/agents/ri-*.md)
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/settings.json

# Environment files
.env
.env.*
!.env.example

# Secrets / certificates
*.pem
*.key
*.p12
*.pfx

# Generated report output (all variants)
*repo-intel-report*.html
*repo-intel-report*.md
*repo-intel-report*.sarif
*repo-intel-report*.json
/reports/
# Legacy "- Copy" duplicates that editors sometimes create
* - Copy.*
*.copy.*

# Temporary files
/tmp/
*.tmp
*.log

# OS artifacts
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
